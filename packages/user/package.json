{
  "name": "@prefabs.tech/react-user",
  "version": "0.72.1",
  "description": "React User Plugin",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/PrefabsTechReactUser.es.js",
      "require": "./dist/PrefabsTechReactUser.umd.js"
    },
    "./dist/PrefabsTechReactUser.css": "./dist/react-user.css"
  },
  "main": "./dist/PrefabsTechReactUser.umd.js",
  "module": "./dist/PrefabsTechReactUser.es.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "snapshot:update": "vitest --environment jsdom run --update --passWithNoTests",
    "sort-package": "npx sort-package-json",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,vue}\" --fix --allow-empty-input",
    "test": "pnpm build && vitest --environment jsdom run --coverage",
    "test:component": "vitest --environment jsdom run component/",
    "test:snapshot": "vitest --environment jsdom run snapshot/",
    "test:unit": "vitest --environment jsdom run unit/ --passWithNoTests",
    "test:watch": "vitest --environment jsdom",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "supertokens-web-js": "0.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@prefabs.tech/eslint-config": "0.8.7",
    "@prefabs.tech/react-form": "0.72.1",
    "@prefabs.tech/react-i18n": "0.72.1",
    "@prefabs.tech/react-layout": "0.72.1",
    "@prefabs.tech/react-ui": "0.72.1",
    "@prefabs.tech/stylelint-config": "0.8.7",
    "@prefabs.tech/tsconfig": "0.8.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axios": "1.18.1",
    "eslint": "10.7.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "primeicons": "7.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "react-toastify": "10.0.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@prefabs.tech/react-form": "0.72.1",
    "@prefabs.tech/react-i18n": "0.72.1",
    "@prefabs.tech/react-layout": "0.72.1",
    "@prefabs.tech/react-ui": "0.72.1",
    "axios": "1.18.1",
    "primeicons": "7.0.0",
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "react-router-dom": ">=6.30",
    "react-toastify": ">=10.0"
  },
  "engines": {
    "node": ">=18"
  }
}
