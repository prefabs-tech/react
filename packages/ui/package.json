{
  "name": "@prefabs.tech/react-ui",
  "version": "0.72.1",
  "description": "React UI Component Library",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/PrefabsTechReactUI.es.js",
      "require": "./dist/PrefabsTechReactUI.umd.js"
    },
    "./dist/PrefabsTechFlagIcon.css": "./dist/flag-icon.css",
    "./dist/PrefabsTechReactUI.css": "./dist/react-ui.css"
  },
  "main": "./dist/PrefabsTechReactUI.umd.js",
  "module": "./dist/PrefabsTechReactUI.es.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "snapshot:update": "vitest --environment jsdom run --update --passWithNoTests",
    "sort-package": "npx sort-package-json",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,vue}\" --fix --allow-empty-input",
    "test": "vitest --environment jsdom run --coverage",
    "test:component": "vitest --environment jsdom run component/",
    "test:snapshot": "vitest --environment jsdom run snapshot/",
    "test:unit": "vitest --environment jsdom run unit/",
    "test:watch": "vitest --environment jsdom",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-table": "8.21.3",
    "file-saver": "2.0.5",
    "node-xlsx": "0.24.0",
    "react-debounce-input": "3.3.0",
    "react-popper": "^2.3.0"
  },
  "devDependencies": {
    "@dzangolab/flag-icon-css": "3.4.5",
    "@prefabs.tech/eslint-config": "0.8.7",
    "@prefabs.tech/stylelint-config": "0.8.7",
    "@prefabs.tech/tsconfig": "0.8.7",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/file-saver": "2.0.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "25.6.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "10.6.0",
    "jsdom": "27.4.0",
    "prettier": "3.8.3",
    "primereact": "9.6.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "stylelint": "17.10.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "3.2.4"
  },
  "peerDependencies": {
    "primereact": "9.6.5",
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "react-router-dom": ">=6.30"
  },
  "engines": {
    "node": ">=18"
  }
}
