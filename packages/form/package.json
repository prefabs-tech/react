{
  "name": "@prefabs.tech/react-form",
  "version": "0.72.1",
  "description": "React Form Component Library",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/PrefabsTechReactForm.es.js",
      "require": "./dist/PrefabsTechReactForm.umd.js"
    },
    "./dist/PrefabsTechReactForm.css": "./dist/react-form.css"
  },
  "main": "./dist/PrefabsTechReactForm.umd.js",
  "module": "./dist/PrefabsTechReactForm.es.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "snapshot:update": "vitest --environment jsdom run --update --passWithNoTests",
    "sort-package": "npx sort-package-json",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "stylelint:fix": "stylelint \"src/**/*.{css,vue}\" --fix --allow-empty-input",
    "test": "vitest --environment jsdom run --coverage",
    "test:component": "vitest --environment jsdom run component/",
    "test:snapshot": "vitest --environment jsdom run snapshot/",
    "test:unit": "vitest --environment jsdom run unit/ --passWithNoTests",
    "test:watch": "vitest --environment jsdom",
    "typecheck": "tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "dependencies": {
    "@hookform/error-message": "2.0.1",
    "@hookform/resolvers": "3.10.0",
    "react-debounce-input": "3.3.0",
    "react-dropzone": "14.4.1",
    "react-hook-form": "7.82.0",
    "validator": "13.15.35",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@prefabs.tech/eslint-config": "0.8.7",
    "@prefabs.tech/react-ui": "0.72.1",
    "@prefabs.tech/stylelint-config": "0.8.7",
    "@prefabs.tech/tsconfig": "0.8.7",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.1.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/validator": "13.15.10",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.7.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "primereact": "9.6.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "@prefabs.tech/react-ui": "0.72.1",
    "primereact": "9.6.5",
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "zod": ">=3.25.76"
  },
  "engines": {
    "node": ">=18"
  }
}
